{
  "model": "fake-model",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/fake/notify stop",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/fake/guard",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "theme": "dark"
}
